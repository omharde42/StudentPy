# ==============================
# StudentPy - Python .gitignore
# ==============================

# Python cache files
__pycache__/
*.py[cod]
*$py.class

# Python virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging
build/
dist/
*.egg-info/

# Test and coverage files
.pytest_cache/
.coverage
htmlcov/
.tox/

# Type checker / linter caches
.mypy_cache/
.pyre/
.ruff_cache/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# IDE settings
.vscode/
.idea/

# Operating system files
.DS_Store
Thumbs.db

# Local environment variables
.env
.env.*

# Logs
*.log

# Temporary files
*.tmp
*.temp

# Local database files
*.db
*.sqlite
*.sqlite3

# Python profiling
*.prof

# Secrets and credentials
*.pem
*.key
secrets.json
credentials.json
